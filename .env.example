# Optional. A GitHub token raises the API limit from 60 to 5,000 requests/hour.
# Use a fine-grained token with "Public repositories (read-only)" access and no
# other permissions. GitCity refuses private repositories even if the token can
# see them, but a public-only token is the safest choice.
GITHUB_TOKEN=

# Optional. Default number of buildings per city (files beyond this are merged
# into "cluster" buildings). Clamped to 200..15000. Default: 6000.
GITCITY_BUILDING_BUDGET=

# Optional. Requests per minute allowed per client IP on the API routes
# (best effort, per server instance). Default: 40.
GITCITY_RATE_LIMIT_PER_MINUTE=
